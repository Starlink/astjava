== as_made
 Begin IntraMap 	# Map points using a private transformation function
    Nin = 2 	# Number of input coordinates
    Nout = 1 	# Number of output coordinates
 IsA Mapping 	# Mapping between coordinate systems
    Fname = "sum2" 	# Name of transformation function
    Purp = "Sum of two inputs" 	# Purpose of function
    Auth = "AST test suite" 	# Author's name
    Cntact = "starlink-ast" 	# Contact address
 End IntraMap
-- read
Nin 2 forward of (1.5, 2.25): 3.75 0
== inverted

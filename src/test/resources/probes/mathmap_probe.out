== dump_default
 Begin MathMap 	# Transformation using mathematical functions
    Nin = 2 	# Number of input coordinates
 IsA Mapping 	# Mapping between coordinate systems
    Nfwd = 4 	# Number of forward transformation functions
    Fwd1 = "r=sqrt(x*x+y*y)" 	# Forward function 1
    Fwd2 = "theta=atan2(y,x)" 	# Forward function 2
    Fwd3 = "rout=r*(1+0.1*r*r)+gauss(0,0.001)" 	# Forward function 3
    Fwd4 = "tout=theta+rand(-1.0e-6,1.0e-6)" 	# Forward function 4
    Inv1 = "x=rout*cos(tout)" 	# Inverse function 1
    Inv2 = "y=rout*sin(tout)" 	# Inverse function 2
 End MathMap
-- fits


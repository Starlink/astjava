== split_shiftmaps
outputs 2
 Begin TranMap 	# Compound Transformation Mapping
    Nin = 1 	# Number of input coordinates
 IsA Mapping 	# Mapping between coordinate systems
    InvB = 1 	# Second Mapping used in inverse direction
    MapA = 	# Mapping for forward transformation
       Begin ShiftMap 	# Shift each coordinate axis
          Nin = 1 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          Sft1 = 20 	# Shift for axis 1
       End ShiftMap
    MapB = 	# Mapping for inverse transformation
       Begin ShiftMap 	# Shift each coordinate axis
          Nin = 1 	# Number of input coordinates
          Invert = 1 	# Mapping inverted
       IsA Mapping 	# Mapping between coordinate systems
          Sft1 = -20 	# Shift for axis 1
       End ShiftMap
 End TranMap
== split_inverted
outputs 3 1
 Begin TranMap 	# Compound Transformation Mapping
    Nin = 2 	# Number of input coordinates
 IsA Mapping 	# Mapping between coordinate systems
    InvB = 1 	# Second Mapping used in inverse direction
    MapA = 	# Mapping for forward transformation
       Begin ShiftMap 	# Shift each coordinate axis
          Nin = 2 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          Sft1 = -30 	# Shift for axis 1
          Sft2 = -10 	# Shift for axis 2
       End ShiftMap
    MapB = 	# Mapping for inverse transformation
       Begin ShiftMap 	# Shift each coordinate axis
          Nin = 2 	# Number of input coordinates
          Invert = 1 	# Mapping inverted
       IsA Mapping 	# Mapping between coordinate systems
          Sft1 = 30 	# Shift for axis 1
          Sft2 = 10 	# Shift for axis 2
       End ShiftMap
 End TranMap

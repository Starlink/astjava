       End MathMap
    ISMap = 	# Inverse selector Mapping
       Begin MathMap 	# Transformation using mathematical functions
          Nin = 1 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          Fwd1 = "y=qif(x>101.5,2,1)" 	# Forward function 1
          Inv1 = "x=qif(y>1800,2,1)" 	# Inverse function 1
       End MathMap
    RMap1 = 	# Route Mapping
       Begin LutMap 	# Map 1-d coordinates using a lookup table
          Nin = 1 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          Nlut = 5 	# Number of lookup table elements
          Start = 1 	# Input value at first element
          Incr = 25 	# Input value increment between elements
          LutInt = 0 	# Interpolation method
          L1 = 1000 	# Lookup table elements...
          L2 = 1100
          L3 = 1300
          L4 = 1600
          L5 = 2000
       End LutMap
    RMap2 = 	# Route Mapping
       Begin MathMap 	# Transformation using mathematical functions

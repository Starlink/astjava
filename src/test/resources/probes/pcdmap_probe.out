== shift_between
class CmpMap
 Begin CmpMap 	# Compound Mapping
    Nin = 2 	# Number of input coordinates
    IsSimp = 1 	# Mapping has been simplified
 IsA Mapping 	# Mapping between coordinate systems
    InvB = 1 	# Second Mapping used in inverse direction
    MapA = 	# First component Mapping
       Begin CmpMap 	# Compound Mapping
          Nin = 2 	# Number of input coordinates
       IsA Mapping 	# Mapping between coordinate systems
          MapA = 	# First component Mapping
             Begin PcdMap 	# Apply pincushion distortion
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                PcdCn0 = 0.29999999999999999 	# Distortion centre on first axis
                PcdCn1 = -0.20000000000000001 	# Distortion centre on second axis
                Disco = 0.01 	# Distortion coefficient
             End PcdMap
          MapB = 	# Second component Mapping
             Begin ShiftMap 	# Shift each coordinate axis
                Nin = 2 	# Number of input coordinates
             IsA Mapping 	# Mapping between coordinate systems
                Sft1 = 0.29999999999999999 	# Shift for axis 1
                Sft2 = -0.20000000000000001 	# Shift for axis 2
             End ShiftMap
       End CmpMap
    MapB = 	# Second component Mapping
       Begin PcdMap 	# Apply pincushion distortion
          Nin = 2 	# Number of input coordinates
          Invert = 1 	# Mapping inverted
       IsA Mapping 	# Mapping between coordinate systems
          PcdCn0 = 0.29999999999999999 	# Distortion centre on first axis
          PcdCn1 = -0.20000000000000001 	# Distortion centre on second axis
          Disco = 0.01 	# Distortion coefficient
       End PcdMap
 End CmpMap
